# ...but web_simulator/models/ holds Wavefront .obj 3D models, not C++ object
# files (MyLaps.obj is loaded by js/course_props.js), so keep those tracked.
!web_simulator/models/*.obj
*.gch
*.pch
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
!/Makefile

# Video files / dataset
mp4/
*.mp4
*.avi
*.mkv
*.mov

# UFLD weights (~234MB, too large for GitHub without LFS). The real vehicle uses the
# YOLOP weights (models/honda_shihou_finetuned_best.pth, tracked); place this file in
# models/ by hand when running lane_detector with backend:=ufld.
models/ufld_honda_finetuned_best.pth

# UFLD ONNX for the web simulator (~245MB, generated by `ros2 run oit_navigation export_ufld_onnx`)
web_simulator/models/ufld.onnx
web_simulator/models/ufld.json

# Cone detector ONNX for the web simulator (generated by `ros2 run oit_navigation export_cone_onnx`)
web_simulator/models/cone.onnx

# superpowers SDD scratch (ledger, briefs, review packages)
.superpowers/

# AI tooling & IDE scratch
.claude/

# 3D raw CAD / interchange formats
*.fbx
*.step
*.stp
*.f3d

# Generic root pretrained models
/yolo11n.pt

# Test dataset images
jpeg/

