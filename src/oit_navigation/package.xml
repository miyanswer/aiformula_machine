<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>oit_navigation</name>
  <version>0.2.0</version>
  <description>Lane detection (YOLOP/UFLD), lap mapping and QP raceline driving, traffic light distance</description>
  <maintainer email="user@todo.todo">user</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>visualization_msgs</depend>
  <depend>builtin_interfaces</depend>
  <depend>can_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>cv_bridge</depend>
  <depend>common_python</depend>
  <depend>sample_vehicle</depend>
  <depend>aiformula_interfaces</depend>

  <exec_depend>rviz2</exec_depend>
  <!-- 判断パネル (utils/debug_panel.py). 日本語フォントは apt で入れる: sudo apt install fonts-noto-cjk
       (無くても動くが日本語が ? になる) -->
  <exec_depend>python3-pil</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
